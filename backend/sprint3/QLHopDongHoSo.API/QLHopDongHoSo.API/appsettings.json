{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ContractManagement;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "FileUpload": {
    "StoragePath": "Storage/Documents",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}